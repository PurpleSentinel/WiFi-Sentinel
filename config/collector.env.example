# Copy this file as .env locally and load via: set -a; source .env; set +a
# It is not loaded by default to avoid surprise configuration.
WIDS_DATABASE=./sentinel.sqlite3
WIDS_HOST=127.0.0.1
WIDS_PORT=8181
# Leave empty for demo-only mode; on Pi usually /dev/serial/by-id/<device>
WIDS_SERIAL_PORT=
WIDS_BAUD=115200
WIDS_WINDOW_SECONDS=10
WIDS_DEAUTH_THRESHOLD=20
WIDS_DISASSOC_THRESHOLD=20
WIDS_AUTH_THRESHOLD=40
WIDS_FAILED_AUTH_THRESHOLD=12
WIDS_COOLDOWN_SECONDS=60
WIDS_RETENTION_DAYS=7
# Comma-separated MAC addresses; empty monitored list means monitor all observed BSSIDs
WIDS_MONITORED_BSSIDS=
# Configure BOTH to enable lookalike SSID alerts (only allowlist actual equipment)
# SSIDs: UTF-8 names, or hex:4100ff for exact bytes; utf8: escapes a literal prefix.
WIDS_PROTECTED_SSIDS=
WIDS_TRUSTED_BSSIDS=
